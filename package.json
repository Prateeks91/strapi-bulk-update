{
  "name": "strapi-plugin-bulk-updater",
  "version": "1.0.0",
  "description": "Bulk update attributes and relationships across multiple collection types in Strapi v5 with schema validation, maker-checker governance, off-peak scheduling, and 3-tier audit rollback.",
  "strapi": {
    "displayName": "Bulk Attribute & Relation Updater",
    "name": "bulk-updater",
    "description": "Mass update attributes and relationships across collection types with schema validation, maker-checker approval, off-peak scheduling, and 3-tier audit rollback.",
    "kind": "plugin"
  },
  "license": "MIT",
  "author": {
    "name": "strapi-utills",
    "url": "https://github.com/strapi-utills"
  },
  "contributors": [
    {
      "name": "Prateek Srivastava",
      "url": "https://github.com/prateeksrivastava"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prateeks91/strapi-bulk-update.git"
  },
  "homepage": "https://github.com/Prateeks91/strapi-bulk-update#readme",
  "bugs": {
    "url": "https://github.com/Prateeks91/strapi-bulk-update/issues"
  },
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-v5",
    "bulk-update",
    "batch-update",
    "relations",
    "audit-log",
    "rollback",
    "maker-checker",
    "off-peak",
    "draft-publish",
    "governance"
  ],
  "type": "commonjs",
  "main": "./dist/server/index.js",
  "module": "./dist/server/index.mjs",
  "source": "./server/src/index.ts",
  "exports": {
    "./strapi-admin": {
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "strapi-admin.js",
    "strapi-server.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "build": "pack-up build",
    "watch": "pack-up watch",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0-rc.0 || ^2.0.0",
    "@strapi/icons": "^2.0.0-rc.0 || ^2.0.0",
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@strapi/pack-up": "^0.1.0",
    "typescript": "^5.0.0"
  }
}
